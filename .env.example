# Copy to .env for local development. Never commit real credentials.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Bedrock Knowledge Base (populated by CDK outputs)
KNOWLEDGE_BASE_ID=REPLACE_ME
DATA_SOURCE_ID=REPLACE_ME
BEDROCK_EMBEDDING_MODEL_ID=amazon.nova-2-multimodal-embeddings-v1:0
BEDROCK_PROMPT_ROUTER_ARN=

# Foundation models — Claude 5 Sonnet (reasoning) + Haiku (fast/cheap) via geo inference profiles
CLAUDE_SONNET_MODEL_ID=us.anthropic.claude-sonnet-5
CLAUDE_HAIKU_MODEL_ID=us.anthropic.claude-haiku-5

# Vector index dimensions must match the S3 Vectors CfnIndex
EMBEDDING_DIMENSION=1024
CACHE_EMBEDDING_DIMENSION=384
SEMANTIC_CACHE_THRESHOLD=0.92

# ElastiCache Serverless
REDIS_ENDPOINT=localhost
REDIS_PORT=6379
REDIS_TLS=false
REDIS_AUTH_TOKEN=

# Source + multimodal storage
SOURCE_BUCKET=mmrag-source
MULTIMODAL_BUCKET=mmrag-multimodal
INGEST_QUEUE_URL=

# Observability
ENVIRONMENT=dev
SERVICE_NAME=mmrag-api
ENABLE_XRAY=false
CLOUDWATCH_NAMESPACE=MMRAG
